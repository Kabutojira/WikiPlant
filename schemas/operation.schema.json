{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/schemas/operation-v1.json",
  "type": "object",
  "required": ["id", "instance_id", "stage", "targets", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "instance_id": {"type": "string", "minLength": 1}, "stage": {"enum": ["intent", "evidence_saved", "wiki_verified", "queue_verified", "complete", "conflict", "blocked"]},
    "targets": {"type": "array", "items": {"type": "object", "required": ["file_id", "input_sha256", "output_sha256"], "properties": {"file_id": {"type": "string"}, "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "observed_revision": {"type": ["integer", "null"]}}}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
