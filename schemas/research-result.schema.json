{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/schemas/research-result-v2.json",
  "type": "object",
  "required": ["id", "question", "attempt_id", "run_id", "origin", "source_ids", "findings", "confidence", "uncertainties", "affected_page_ids", "applicability", "selected_followup_ids", "status"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "item_id": {"type": "string"},
    "topic_ids": {"type": "array", "items": {"type": "string"}},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "challenge_ids": {"type": "array", "items": {"type": "string"}},
    "correction_ids": {"type": "array", "items": {"type": "string"}},
    "applicability_records": {"type": "array", "items": {"$ref": "applicability.schema.json"}},
    "scope_revision": {"type": ["integer", "null"], "minimum": 1},
    "evidence_assessment_ref": {"type": ["string", "null"]},
    "changed_conclusions": {"type": "array", "items": {"type": "string"}},
    "id": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "origin": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}}, "findings": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "string"}, "uncertainties": {"type": "array", "items": {"type": "string"}},
    "affected_page_ids": {"type": "array", "items": {"type": "string"}}, "applicability": {"type": "array", "items": {"type": "string"}}, "selected_followup_ids": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "status": {"enum": ["complete", "partial", "blocked"]}
  },
  "additionalProperties": true
}
