    "max_queries": {"type": "integer", "minimum": 1}, "max_sources": {"type": "integer", "minimum": 1}, "queries_used": {"type": "integer", "minimum": 0}, "sources_used": {"type": "integer", "minimum": 0},
    "status": {"enum": ["in_progress", "complete", "no_material_update", "partial", "blocked"]}, "findings": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
