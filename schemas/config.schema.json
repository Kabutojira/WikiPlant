{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/schemas/config-v2.json",
  "type": "object",
  "required": ["schema_version", "instance", "storage", "runtime", "skill", "primary_topic_ids", "schedules", "initialization", "queue", "expansion", "main_topic_refresh", "topic_governance", "queue_admission"],
  "properties": {
    "schema_version": {"const": 2},
    "instance": {
      "type": "object",
      "required": ["id", "name", "language", "timezone"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 2}, "timezone": {"type": "string", "minLength": 1}}
    },
    "storage": {
      "type": "object",
      "properties": {
        "provider": {"enum": ["google-drive", "github"]},
        "root_folder_id": {"type": "string", "minLength": 1},
        "repository_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "canonical_ref": {"type": "string", "pattern": "^refs/heads/(?![./])(?!.*(?:\\.\\.|//|@\\{|\\.lock$))[A-Za-z0-9._/-]*[A-Za-z0-9_-]$"},
        "root_prefix": {"const": ""},
        "consistency_mode": {"enum": ["strict", "best-effort-personal", "git-fast-forward"]},
        "personal_lock": {
          "type": "object",
          "required": ["file_id", "logical_path", "stale_after_hours"],
          "properties": {
            "file_id": {"type": "string", "minLength": 1},
            "logical_path": {"const": "data/state/research.lock.json"},
            "stale_after_hours": {"const": 20}
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": ["max_file_bytes", "max_transaction_bytes", "max_repository_bytes", "max_paths_per_transaction"],
          "properties": {
            "max_file_bytes": {"type": "integer", "minimum": 1},
            "max_transaction_bytes": {"type": "integer", "minimum": 1},
            "max_repository_bytes": {"type": "integer", "minimum": 1},
            "max_paths_per_transaction": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        {
          "required": ["provider", "root_folder_id", "consistency_mode"],
          "properties": {
            "provider": {"const": "google-drive"},
            "consistency_mode": {"enum": ["strict", "best-effort-personal"]}
          },
          "not": {"anyOf": [
            {"required": ["repository_id"]}, {"required": ["repository"]},
            {"required": ["canonical_ref"]}, {"required": ["root_prefix"]}, {"required": ["limits"]}
          ]}
        },
        {
          "required": ["provider", "repository_id", "repository", "canonical_ref", "root_prefix", "consistency_mode", "limits"],
          "properties": {
            "provider": {"const": "github"},
            "consistency_mode": {"const": "git-fast-forward"}
          },
          "not": {"anyOf": [{"required": ["root_folder_id"]}, {"required": ["personal_lock"]}]}
        }
      ]
    },
    "runtime": {"type": "object", "required": ["release_id", "source_commit", "manifest_sha256", "upgrades"], "properties": {"upgrades": {"const": "explicit-user-request"}}},
    "skill": {"type": "object", "required": ["per_instance", "routing_profile_revision"], "properties": {"per_instance": {"const": true}, "routing_profile_revision": {"type": "integer", "minimum": 1}}},
    "primary_topics": false,
    "primary_topic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "topic_governance": {"type": "object", "required": ["max_active_adjacent_topics", "max_active_peripheral_topics", "peripheral_expiry"], "properties": {"max_active_adjacent_topics": {"type": "integer", "minimum": 1}, "max_active_peripheral_topics": {"type": "integer", "minimum": 1}, "peripheral_expiry": {"const": "next_weekly_maintenance"}, "archive_summary_target_words": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}}},
    "queue_admission": {"type": "object", "required": ["max_active_automatic_items", "max_new_automatic_roots_per_day", "revalidate_pending_after_days", "automatic_candidate_deferral_days"], "properties": {"max_active_automatic_items": {"type": "integer", "minimum": 1}, "max_new_automatic_roots_per_day": {"type": "integer", "minimum": 1}, "revalidate_pending_after_days": {"type": "integer", "minimum": 1}, "automatic_candidate_deferral_days": {"type": "integer", "minimum": 1}}},
    "schedules": {"type": "object"},
    "initialization": {"type": "object", "properties": {"max_research_attempts": {"const": 5}}},
    "queue": {"type": "object", "properties": {"normal_daily_attempts": {"const": 5}, "urgent_daily_attempts_total": {"const": 10}, "urgent_priority": {"const": 0}}},
    "expansion": {"type": "object", "properties": {"child_priority_increment": {"type": "integer", "minimum": 1}, "max_children_per_research": {"type": "integer", "minimum": 1}, "preserve_expansion_priority": {"const": true}}},
    "main_topic_refresh": {"type": "object", "properties": {"enabled": {"const": true}, "outside_queue_budget": {"const": true}, "max_search_queries_per_topic": {"type": "integer", "minimum": 1}, "max_source_fetches_per_topic": {"type": "integer", "minimum": 1}}}
  },
  "additionalProperties": true
}
