    "release": {"type": "object"}, "compatible": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}},
    "saved_reference": {"type": ["string", "null"]}, "result_published": {"type": "boolean"}, "notification_observed": {"type": ["boolean", "null"]},
    "publication_payload": {"type": "string", "minLength": 1}, "publication_reference": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
