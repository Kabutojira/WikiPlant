{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/schemas/claim-v2.json",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "subject",
    "predicate",
    "value",
    "source_ids",
    "confidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "reported",
        "supported",
        "disputed",
        "uncertain",
        "hypothesis",
        "user_note",
        "superseded"
      ]
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "evidence-link.schema.json"
      }
    },
    "dependency_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "units": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessment_reason": {
      "type": "string"
    },
    "claim_type": {
      "type": "string"
    },
    "assessed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "impact": {
      "enum": [
        "ordinary",
        "consequential"
      ]
    },
    "challenge_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_required": {
      "type": "boolean"
    },
    "predecessor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extra_fields": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          },
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "schema_version",
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence_links",
          "assessment_reason",
          "assessed_at"
        ],
        "properties": {
          "evidence_links": {
            "type": "array",
            "minItems": 1
          },
          "assessment_reason": {
            "type": "string",
            "minLength": 1
          },
          "assessed_at": {
            "type": "string",
            "format": "date-time"
          },
          "review_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "not": {
              "const": "verified"
            }
          }
        }
      }
    }
  ]
}
