{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/schemas/wiki-page-v1.json",
  "type": "object",
  "required": ["schema_version", "id", "title", "type", "aliases", "topic_ids", "created_at", "updated_at", "source_ids", "research_ids", "relationship_ids"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["entity", "concept", "project", "synthesis"]}, "aliases": {"type": "array", "items": {"type": "string"}}, "topic_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "last_checked_at": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "items": {"type": "string"}}, "research_ids": {"type": "array", "items": {"type": "string"}}, "relationship_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
