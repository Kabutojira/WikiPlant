{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikiplant.invalid/release/runtime-manifest-v1.json",
  "type": "object",
  "required": ["schema_version", "release_id", "source_commit", "status", "max_file_bytes", "max_total_bytes", "files"],
  "properties": {
    "schema_version": {"const": 1}, "release_id": {"type": "string", "minLength": 1}, "source_commit": {"type": "string"}, "status": {"enum": ["draft", "released"]},
    "max_file_bytes": {"type": "integer", "maximum": 512000}, "max_total_bytes": {"type": "integer", "maximum": 8000000},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "size", "encoding"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0, "maximum": 512000}, "encoding": {"const": "utf-8"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
